rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the request matches the user's UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if the user has the isAdmin flag in their profile
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Expert Identity Helpers ---
    function getMyExpertId() {
      return exists(/databases/$(database)/documents/expertUserLinks/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/expertUserLinks/$(request.auth.uid)).data.expertId : null;
    }

    function isActingAsExpertForClient(clientUserId, requiredCategory) {
      let expertId = getMyExpertId();
      let relId = expertId + '_' + clientUserId;
      return expertId != null &&
             exists(/databases/$(database)/documents/expertProfiles/$(expertId)) &&
             get(/databases/$(database)/documents/expertProfiles/$(expertId)).data.active == true &&
             exists(/databases/$(database)/documents/expertClientRelationships/$(relId)) &&
             get(/databases/$(database)/documents/expertClientRelationships/$(relId)).data.status == 'active' &&
             get(/databases/$(database)/documents/expertClientRelationships/$(relId)).data.consentStatus == 'granted' &&
             requiredCategory in get(/databases/$(database)/documents/expertClientRelationships/$(relId)).data.consentedDataCategories;
    }


    // --- Users Collection ---
    // Contains user profiles, settings, and safe foods.
    // --- Users Collection ---
    // Contains user profiles, settings, and safe foods.
    match /users/{userId} {
      // Allow users to read (get) their own document. Admins can get any. Experts can read if profile consent is granted.
      allow get: if isOwner(userId) || isAdmin() || isActingAsExpertForClient(userId, 'profile');
      
      // Allow ONLY Admins to list all users (for acquisition stats).
      // 'isOwner' cannot be used for list() as it requires checking every doc against the UID, which fails query validation without a where clause.
      allow list: if isAdmin();
      
      // SECURITY FIX: Prevent Privilege Escalation
      // Users cannot set 'isAdmin' or 'premium' to true on creation.
      allow create: if isOwner(userId) && 
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('premium' in request.resource.data) || request.resource.data.premium == false);

      // Users cannot modify 'isAdmin' or 'premium' on update.
      allow update: if isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'premium']));

      // Allow users to delete their own account
      allow delete: if isOwner(userId);

      // --- Subcollections ---
      match /timelineEntries/{entryId} {
        // Experts can read if foodJournal consent is granted.
        allow read: if isOwner(userId) || isActingAsExpertForClient(userId, 'foodJournal');
        allow write: if isOwner(userId);
      }

      // --- Integration Debug Logs ---
      match /integration_debug_logs/{logId} {
        allow read, write: if isOwner(userId);
      }

      // --- Saved Ramadan Cards ---
      match /saved_ramadan_cards/{cardId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          // Schema Validation: Must have core fields
          request.resource.data.keys().hasAll(['title', 'content', 'topicId', 'category']) &&
          // Privacy: Must NOT contain raw user profile data
          !request.resource.data.keys().hasAny(['userProfile', 'tdee', 'weight', 'age', 'healthGoals']);
          
        allow delete: if isOwner(userId);
      }
    }

    // --- Feedback Collection ---
    // Stores user feedback entries.
    match /feedbackSubmissions/{feedbackId} {
      // Allow any authenticated user to create feedback.
      allow create: if isAuthenticated();

      // Allow users to read ONLY their own feedback.
      // Allow admins to read ALL feedback.
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      
      // Allow list queries:
      // 1. Users filtering by their own UID.
      // 2. Admins (who might query all documents).
      allow list: if (isAuthenticated() && request.query.filters.userId == request.auth.uid) || isAdmin();
      
      // Allow admins to update status (e.g. mark as viewed)
      allow update: if isAdmin();
    }

    // --- Admin Events (Hallucinations) ---
    match /admin_events/{eventId} {
      allow read, write: if isAdmin();
    }

    // --- Admin Settings (App Journey Milestones) ---
    match /admin_settings/{settingId} {
      // Allow read for everyone (so the journey can be shown publicly or to guests)
      allow read: if true;
      // Allow write only for admins
      allow write: if isAdmin();
    }

    // --- Ramadan Remote Config ---
    match /config/ramadan {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Contact Submissions ---
    match /contact_submissions/{submissionId} {
      // Allow anyone (even unauthenticated) to submit a contact form
      allow create: if true;
      // Only admins can read/manage these
      allow read, update, delete: if isAdmin();
    }

    // --- Audit Deleted Users ---
    // Critical audit log for account deletions.
    match /audit_deleted_users/{documentId} {
      // Allow authenticated users to create a log entry (simplified for reliability)
      allow create: if isAuthenticated();
      // Only admins can read these records.
      allow read: if isAdmin();
      // NOBODY can update or delete audit logs.
      allow update, delete: if false;
    }

    // --- App Performance Metrics ---
    // Stores client performance measurements (e.g., time to first render).
    match /app_performance_metrics/{metricId} {
      allow create: if request.resource.data.keys().hasOnly([
          'ttfrMs', 'createdAt', 'platform', 'isNative', 'userId', 'sessionId'
        ]) &&
        (request.resource.data.ttfrMs is int || request.resource.data.ttfrMs is float) &&
        request.resource.data.ttfrMs >= 0 &&
        request.resource.data.ttfrMs < 60000;

      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // --- AI Performance Metrics ---
    match /ai_performance_metrics/{metricId} {
      allow create: if request.resource.data.keys().hasOnly([
          'flow', 'durationMs', 'success', 'userId', 'entryId', 'platform', 'createdAt'
        ]) &&
        request.resource.data.flow in ['write', 'scan', 'reuse'] &&
        (request.resource.data.durationMs is int || request.resource.data.durationMs is float) &&
        request.resource.data.durationMs >= 0 &&
        request.resource.data.durationMs < 120000;

      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // --- AI Telemetry Events ---
    match /ai_telemetry_events/{eventId} {
      allow create: if request.resource.data.keys().hasOnly([
          'type', 'userId', 'entryId', 'reason', 'meta', 'timestamp'
        ]) &&
        request.resource.data.type in [
          'recalc_skipped',
          'override_persisted_after_edit',
          'missing_macros',
          'missing_health_tags',
          'hallucination_flagged'
        ];

      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // --- EXPERT FEATURE COLLECTIONS ---
    
    match /expertUserLinks/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /expertProfiles/{expertId} {
      // Anyone authenticated can read active profiles (needed to select an expert)
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /expertClientRelationships/{relId} {
      // relId is enforced to be {expertId}_{clientUserId}
      // Users can read their own relationships
      allow read: if isAuthenticated() && (
        resource.data.clientUserId == request.auth.uid || 
        resource.data.expertId == getMyExpertId() || 
        isAdmin()
      );
      
      // Users can only create/update their own consent
      allow create: if isAuthenticated() && 
                    request.resource.data.clientUserId == request.auth.uid &&
                    relId == (request.resource.data.expertId + '_' + request.auth.uid) &&
                    exists(/databases/$(database)/documents/expertProfiles/$(request.resource.data.expertId));
                    
      allow update: if isAuthenticated() && 
                    resource.data.clientUserId == request.auth.uid &&
                    // Ensure they don't try to change the expert or user link
                    request.resource.data.expertId == resource.data.expertId &&
                    request.resource.data.clientUserId == resource.data.clientUserId;
    }

    match /expertConsentVersions/{versionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /expertConsentAuditEvents/{eventId} {
      // Append only, client creates it for themselves
      allow create: if isAuthenticated() && request.resource.data.clientUserId == request.auth.uid;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.clientUserId == request.auth.uid);
      allow update, delete: if false;
    }

    match /foodRealityCaptures/{captureId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isActingAsExpertForClient(resource.data.userId, 'foodRealityCapture')
      );
      allow write: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        isActingAsExpertForClient(request.resource.data.userId, 'foodRealityCapture')
      );
    }

    match /foodRealityDaySummaries/{summaryId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isActingAsExpertForClient(resource.data.userId, 'foodRealityCapture')
      );
      allow write: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        isActingAsExpertForClient(request.resource.data.userId, 'foodRealityCapture')
      );
    }

    match /foodRealityReports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isActingAsExpertForClient(resource.data.userId, 'foodRealityReport')
      );
      // Only server/Cloud Function should write reports ideally, but if client writes:
      allow write: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        isActingAsExpertForClient(request.resource.data.userId, 'foodRealityReport')
      );
    }

    match /expertNotes/{noteId} {
      // Only the specific expert can read/write their notes
      allow read, write: if isAuthenticated() && resource.data.expertId == getMyExpertId();
      // On create, must match current expert ID
      allow create: if isAuthenticated() && request.resource.data.expertId == getMyExpertId();
    }

    // --- Default Deny ---
    // Explicitly deny access to any other potential collections not listed here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
