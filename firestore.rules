rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the request matches the user's UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if the user has the isAdmin flag in their profile
    function isAdmin() {

      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Users Collection ---
    // Contains user profiles, settings, and safe foods.
    // --- Users Collection ---
    // Contains user profiles, settings, and safe foods.
    match /users/{userId} {
      // Allow users to read (get) their own document. Admins can get any.
      allow get: if isOwner(userId) || isAdmin();
      
      // Allow ONLY Admins to list all users (for acquisition stats).
      // 'isOwner' cannot be used for list() as it requires checking every doc against the UID, which fails query validation without a where clause.
      allow list: if isAdmin();
      
      // SECURITY FIX: Prevent Privilege Escalation
      // Users cannot set 'isAdmin' or 'premium' to true on creation.
      allow create: if isOwner(userId) && 
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('premium' in request.resource.data) || request.resource.data.premium == false);

      // Users cannot modify 'isAdmin' or 'premium' on update.
      allow update: if isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'premium']));

      // Allow users to delete their own account
      allow delete: if isOwner(userId);

      // --- Subcollections ---
      match /timelineEntries/{entryId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- Feedback Collection ---
    // Stores user feedback entries.
    match /feedbackSubmissions/{feedbackId} {
      // Allow any authenticated user to create feedback.
      allow create: if isAuthenticated();

      // Allow users to read ONLY their own feedback.
      // Allow admins to read ALL feedback.
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      
      // Allow list queries:
      // 1. Users filtering by their own UID.
      // 2. Admins (who might query all documents).
      allow list: if (isAuthenticated() && request.query.filters.userId == request.auth.uid) || isAdmin();
      
      // Allow admins to update status (e.g. mark as viewed)
      allow update: if isAdmin();
    }

    // --- Admin Events (Hallucinations) ---
    match /admin_events/{eventId} {
      allow read, write: if isAdmin();
    }

    // --- Contact Submissions ---
    match /contact_submissions/{submissionId} {
      // Allow anyone (even unauthenticated) to submit a contact form
      allow create: if true;
      // Only admins can read/manage these
      allow read, update, delete: if isAdmin();
    }

    // --- Audit Deleted Users ---
    // Critical audit log for account deletions.
    match /audit_deleted_users/{documentId} {
      // Allow authenticated users to create a log entry (simplified for reliability)
      allow create: if isAuthenticated();
      // Only admins can read these records.
      allow read: if isAdmin();
      // NOBODY can update or delete audit logs.
      allow update, delete: if false;
    }

    // --- Default Deny ---
    // Explicitly deny access to any other potential collections not listed here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
